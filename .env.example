# BucketAI Configuration
# GEMINI_API_KEY: Used strictly on the server-side proxy / Netlify serverless function
# for structured batch bucket naming. Never exposed to browser client bundles.
# When unavailable or omitted, BucketAI continues working via offline TF-IDF heuristics.
GEMINI_API_KEY=YOUR_API_KEY

# APP_URL: The URL where this applet is hosted.
APP_URL="http://localhost:3000"
